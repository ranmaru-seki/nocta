---
// NOCTA ロゴ：三日月のくぼみに、コーヒー豆が眠っているエンブレム＋ワードマーク
interface Props {
  id: string;          // マスクIDの重複を避けるための識別子
  size?: number;       // エンブレムの大きさ(px)
  tagline?: boolean;   // 「NIGHT ROAST CLUB」を出すか
}
const { id, size = 38, tagline = true } = Astro.props;
const maskId = `nc-moon-${id}`;
---
<span class="nc-logo">
  <svg class="nc-logo-mark" aria-hidden="true" width={size} height={size} viewBox="0 0 40 40">
    <defs>
      <mask id={maskId}>
        <rect width="40" height="40" fill="#fff"></rect>
        <circle cx="25.5" cy="15" r="11.2" fill="#000"></circle>
      </mask>
    </defs>
    <circle cx="20" cy="20" r="19.2" fill="none" stroke="#E3A857" stroke-opacity="0.45" stroke-width="0.8"></circle>
    <circle cx="20" cy="20" r="13.4" fill="#E3A857" mask={`url(#${maskId})`}></circle>
    <g transform="rotate(38 25.6 15.4)">
      <ellipse cx="25.6" cy="15.4" rx="3.5" ry="5.1" fill="#EDEAE4"></ellipse>
      <path d="M25.9 10.6c-1.6 1.6-1.6 3.2-.3 4.8s1.3 3.2-.3 4.8" fill="none" stroke="#0F0F10" stroke-width="0.9" stroke-linecap="round"></path>
    </g>
    <circle cx="11.6" cy="9.4" r="0.9" fill="#EDEAE4"></circle>
    <circle cx="31.4" cy="28.2" r="0.7" fill="#EDEAE4" fill-opacity="0.7"></circle>
  </svg>
  <span class="nc-logo-type">
    <span class="nc-logo-name">NOCTA</span>
    {tagline && <span class="nc-logo-sub">NIGHT ROAST CLUB</span>}
  </span>
</span>

<style>
  .nc-logo { display: inline-flex; align-items: center; gap: 12px; color: #EDEAE4; }
  .nc-logo-mark { flex-shrink: 0; transition: transform .8s cubic-bezier(.2,.8,.2,1); }
  :global(a:hover) .nc-logo-mark { transform: rotate(-18deg); }
  .nc-logo-type { display: flex; flex-direction: column; gap: 3px; padding-left: 12px; border-left: 1px solid rgba(237,234,228,0.22); line-height: 1; }
  .nc-logo-name { font-family: 'Instrument Serif', serif; font-size: 25px; letter-spacing: 0.22em; line-height: 0.9; }
  .nc-logo-sub { font-family: 'Zen Kaku Gothic New', sans-serif; font-size: 8px; font-weight: 700; letter-spacing: 0.34em; color: #E3A857; }
</style>
