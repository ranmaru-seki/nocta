---
// キャッチコピーとフォントの比較用ページ（確認が終わったら削除する）
import Logo from '../components/Logo.astro';
const description = 'NOCTA キャッチコピー・フォント比較';
const title = 'NOCTA';
const ogImage = new URL('/og.jpg', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>キャッチコピー・フォント比較｜NOCTA</title>
<meta name="description" content={description}>
<meta name="robots" content="noindex">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="theme-color" content="#0F0F10">
<meta property="og:type" content="website">
<meta property="og:site_name" content="NOCTA">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" as="image" href="/images/hero-window.webp" fetchpriority="high">
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&amp;family=Shippori+Mincho:wght@500;600&amp;family=Zen+Old+Mincho:wght@500;600&amp;family=Noto+Serif+JP:wght@500&amp;family=Instrument+Serif:ital@0;1&amp;display=swap" rel="stylesheet">
<style is:global>
img{height:auto}
.nc-hero-btns{margin-top:16px}
body{margin:0;background:#0F0F10}
a{color:#EDEAE4}a:hover{color:#E3A857}
@keyframes nc-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.nc-track{animation:nc-marquee 40s linear infinite}
.nc-card{transition:border-color .4s ease, transform .4s ease}
.nc-card:hover{border-color:rgba(227,168,87,0.45);transform:translateY(-3px)}
.nc-zoom{overflow:hidden}
.nc-zoom img{transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
.nc-zoom:hover img{transform:scale(1.05)}
.nc-btn{transition:filter .3s ease, transform .3s ease}
.nc-btn:hover{filter:brightness(1.08);transform:translateY(-2px)}
.nc-arrow{transition:transform .3s cubic-bezier(.2,.8,.2,1)}
.nc-btn:hover .nc-arrow{transform:translateX(4px)}
.nc-cta{position:relative;overflow:hidden}
.nc-cta::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.45),transparent);transform:skewX(-20deg);animation:nc-shine 4.2s ease-in-out infinite}
@keyframes nc-shine{0%,72%{left:-60%}100%{left:130%}}
@keyframes nc-steam{0%{opacity:0;transform:translateY(8px)}40%{opacity:.9}100%{opacity:0;transform:translateY(-14px)}}
.nc-plan-deco{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.nc-plan-deco img{position:absolute;filter:drop-shadow(0 18px 22px rgba(0,0,0,0.55))}
.nc-plan-deco .d1{right:-70px;top:70px;width:340px;opacity:.55;transform:rotate(-24deg)}
.nc-plan-deco .d2{left:5%;top:120px;width:120px;opacity:.75;transform:rotate(-28deg)}
.nc-plan-deco .d3{left:-70px;bottom:-50px;width:330px;opacity:.5;transform:rotate(12deg)}
.nc-plan-deco .d4{right:6%;bottom:36px;width:110px;opacity:.6;transform:rotate(22deg)}
.nc-plan-deco .d5{left:30%;top:-60px;width:220px;opacity:.18;transform:rotate(180deg);filter:blur(2px)}
@media (max-width: 760px){
  .nc-plan-deco .d1{width:200px;right:-70px;top:30px;opacity:.4}
  .nc-plan-deco .d2{width:70px;left:-10px;top:40px;opacity:.6}
  .nc-plan-deco .d3{width:200px;left:-80px;bottom:40px;opacity:.35}
  .nc-plan-deco .d4{width:70px;right:-10px;bottom:30px}
}
.nc-bags:hover .nc-bag-l{transform:rotate(-9deg) translateX(-10px)}
.nc-bags:hover .nc-bag-r{transform:rotate(9deg) translateX(10px)}
.nc-bags:hover .nc-bag-c{transform:translateY(-8px)}
.nc-faq summary{list-style:none;cursor:pointer}
.nc-faq summary::-webkit-details-marker{display:none}
.nc-faq[open] .nc-chev{transform:rotate(180deg)}
.nc-chev{transition:transform .3s ease}
.nc-hero-img{transform:scaleX(-1)}
@media (max-width: 960px){
  .nc-hide-tab{display:none !important}
  .nc-why{grid-template-columns:1fr 1fr !important}
  .nc-why-big{grid-column:1 / -1 !important;grid-row:auto !important}
  .nc-how{grid-template-columns:1fr !important}
  .nc-how-photo{min-height:360px !important}
}
@media (max-width: 760px){
  .nc-hide-sp{display:none !important}
  .nc-why{grid-template-columns:1fr !important}
  .nc-hero{min-height:720px !important;align-items:flex-end !important}
  .nc-hero-img{object-position:30% 0 !important}
  .nc-hero-shade{background:linear-gradient(180deg, rgba(15,15,16,0.1) 0%, rgba(15,15,16,0.55) 38%, #0F0F10 70%) !important}
  .nc-bags{transform:scale(0.6);margin:-60px -80px -70px !important}
  .nc-sticky-note{display:none !important}
  .nc-sticky{padding-left:18px !important}
  .nc-logo-name{font-size:21px !important}
  .nc-head-btn{padding:10px 18px !important}
  .nc-hero-btns{width:100%;flex-direction:column;margin-top:20px}
  .nc-hero-btns > a{justify-content:center;width:100%}
  .nc-product{min-height:340px !important}
  .nc-interlude{min-height:420px !important}
  .nc-final-shade{background:linear-gradient(180deg, #0F0F10 0%, rgba(15,15,16,0.7) 25%, rgba(15,15,16,0.66) 75%, #0F0F10 100%) !important}
}
@keyframes nc-appear{from{opacity:0;transform:translateY(24px);visibility:hidden}to{opacity:1;transform:none;visibility:visible}}
@supports (animation-timeline: scroll()){.nc-sticky-wrap{animation:nc-appear linear both;animation-timeline:scroll(root);animation-range:600px 760px}}
@media (prefers-reduced-motion: reduce){.nc-track{animation:none}.nc-cta::after{animation:none;display:none}}

html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
